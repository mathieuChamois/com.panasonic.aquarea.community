        "onoff.tank",
        "onoff.zone",
        "measure_temperature",
        "measure_temperature.zone",
        "measure_temperature.outdoor",
        "operation_direction",
        "special_status",
        "quiet_mode",
        "powerful_mode",
        "defrost_active",
        "force_heater",
        "force_dhw",
        "electric_anode",
        "holiday_mode",
        "measure_water_pressure",
        "pump_running"
      ],
      "capabilitiesOptions": {
        "onoff.tank": {
          "title": {
            "en": "Tank (DHW)",
            "fr": "Ballon (ECS)"
          },
          "insightsTitleTrue": {
            "en": "Tank on",
            "fr": "Ballon allume"
          },
          "insightsTitleFalse": {
            "en": "Tank off",
            "fr": "Ballon eteint"
          }
        },
        "onoff.zone": {
