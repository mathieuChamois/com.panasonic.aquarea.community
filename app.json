          "en": "[[device]]: [[capability]] is on",
          "fr": "[[device]] : [[capability]] est activé"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "capabilities=pump_running|defrost_active|force_dhw|force_heater|bivalent_active|electric_anode|holiday_mode|convector_flap"
          },
          {
            "name": "capability",
            "type": "dropdown",
            "values": [
              {
                "id": "pump_running",
                "title": {
                  "en": "Circulation pump",
                  "fr": "Circulateur"
                }
              },
              {
                "id": "defrost_active",
                "title": {
                  "en": "Defrosting",
                  "fr": "Degivrage"
                }
              },
              {
                "id": "force_dhw",
                "title": {
                  "en": "Forced hot water",
                  "fr": "Eau chaude forcee"
                }
              },
              {
                "id": "force_heater",
                "title": {
                  "en": "Backup heater",
                  "fr": "Appoint electrique"
                }
              },
              {
                "id": "bivalent_active",
                "title": {
                  "en": "Bivalent source",
                  "fr": "Source bivalente"
                }
              },
              {
                "id": "electric_anode",
                "title": {
                  "en": "Electric anode",
                  "fr": "Anode electrique"
                }
              },
              {
                "id": "holiday_mode",
                "title": {
                  "en": "Holiday mode",
                  "fr": "Mode vacances"
                }
              },
              {
                "id": "convector_flap",
                "title": {
                  "en": "Convector flap",
                  "fr": "Volet du convecteur"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "capability_equals",
        "title": {
          "en": "Aquarea [[capability]] equals [[value]]",
          "fr": "Aquarea [[capability]] est egal a [[value]]"
        },
        "titleFormatted": {
          "en": "[[device]]: [[capability]] equals [[value]]",
          "fr": "[[device]] : [[capability]] est egal a [[value]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "capabilities=operation_direction|special_status|quiet_mode|powerful_mode|convector_fan_speed"
          },
          {
            "name": "capability",
            "type": "dropdown",
            "values": [
              {
                "id": "operation_direction",
                "title": {
                  "en": "Current operation",
                  "fr": "Fonctionnement en cours"
                }
              },
              {
                "id": "special_status",
                "title": {
                  "en": "Eco / Comfort preset",
                  "fr": "Prereglage Eco / Confort"
                }
              },
              {
                "id": "quiet_mode",
                "title": {
                  "en": "Quiet mode",
                  "fr": "Mode silencieux"
                }
              },
              {
                "id": "powerful_mode",
                "title": {
                  "en": "Powerful mode",
                  "fr": "Mode puissant"
                }
              },
              {
                "id": "convector_fan_speed",
                "title": {
                  "en": "Fan speed",
                  "fr": "Vitesse ventilateur"
                }
              }
            ]
          },
          {
            "name": "value",
            "type": "text",
            "placeholder": {
              "en": "Value",
              "fr": "Valeur"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_zone_setpoint",
        "title": {
          "en": "Set zone setpoint / curve offset to [[value]]",
          "fr": "Regler la consigne zone / le decalage de loi d'eau sur [[value]]"
        },
        "titleFormatted": {
          "en": "Set [[device]] zone setpoint / curve offset to [[value]]",
          "fr": "Regler la consigne zone / le decalage de loi d'eau de [[device]] sur [[value]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "capabilities=target_temperature.zone"
          },
          {
            "name": "value",
            "type": "number",
            "title": {
              "en": "Setpoint / offset",
              "fr": "Consigne / decalage"
            },
            "min": -5,
            "max": 60,
            "step": 1
          }
        ]
      },
