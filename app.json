  "drivers": [
    {
      "id": "aquarea_convector",
      "name": {
        "en": "Aquarea Convector (Aquarea Home)",
        "fr": "Convecteur Aquarea (Aquarea Home)"
      },
      "class": "thermostat",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "thermostat_mode",
        "convector_fan_speed",
        "convector_flap"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 5,
          "max": 40,
          "step": 1,
          "units": {
            "en": "°C",
            "fr": "°C"
          }
        },
        "thermostat_mode": {
          "title": {
            "en": "Operation mode",
            "fr": "Mode de fonctionnement"
          },
          "values": [
            {
              "id": "auto",
              "title": {
                "en": "Auto",
                "fr": "Auto"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat",
                "fr": "Chauffage"
              }
            },
            {
              "id": "cool",
              "title": {
                "en": "Cool",
                "fr": "Rafraichissement"
              }
            }
          ]
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/aquarea_convector/assets/images/small.png",
        "large": "/drivers/aquarea_convector/assets/images/large.png",
        "xlarge": "/drivers/aquarea_convector/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Aquarea Home e-mail",
              "fr": "E-mail Aquarea Home"
            },
            "passwordLabel": {
              "en": "Password",
              "fr": "Mot de passe"
            }
          },
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
