      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Polling",
            "fr": "Interrogation (polling)"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Polling interval (seconds)",
                "fr": "Intervalle d'interrogation (secondes)"
              },
              "hint": {
                "en": "Time between cloud refreshes. Do NOT set this too low: Aquarea Smart Cloud rate-limits requests and may temporarily ban your IP or lock your account. Minimum 60 s, recommended 300 s.",
                "fr": "Delai entre deux rafraichissements. Ne PAS mettre une valeur trop basse : Aquarea Smart Cloud limite le debit et peut bannir temporairement votre IP ou verrouiller le compte. Minimum 60 s, recommande 300 s."
              },
              "value": 300,
              "min": 60,
              "max": 3600,
              "units": {
                "en": "s",
                "fr": "s"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Installation details (read-only)",
            "fr": "Details de l'installation (lecture seule)"
          },
          "children": [
            {
              "id": "info_service_type",
              "type": "label",
              "label": {
                "en": "Service type",
                "fr": "Type de service"
              },
              "value": "-"
            },
            {
              "id": "info_model_series",
              "type": "label",
              "label": {
                "en": "Model series",
                "fr": "Serie du modele"
              },
              "value": "-"
            },
            {
              "id": "info_zones",
              "type": "label",
              "label": {
                "en": "Heating zones",
                "fr": "Zones de chauffage"
              },
              "value": "-"
            },
            {
              "id": "info_zone_control",
              "type": "label",
              "label": {
                "en": "Zone setpoint type",
                "fr": "Type de consigne de zone"
              },
              "hint": {
                "en": "Whether the zone setpoint is an absolute water temperature or an offset applied to the weather-compensation curve.",
                "fr": "Indique si la consigne de zone est une temperature d'eau absolue ou un decalage applique a la loi d'eau."
              },
              "value": "-"
            },
            {
              "id": "info_zone_sensor",
              "type": "label",
              "label": {
                "en": "Zone sensor",
                "fr": "Sonde de zone"
              },
              "hint": {
                "en": "Which sensor drives the zone. With 'Water temperature' the heat pump reports the circuit water temperature, not a room temperature.",
                "fr": "Sonde qui pilote la zone. Avec 'Temperature d'eau', la pompe a chaleur remonte la temperature d'eau du circuit et non une temperature ambiante."
              },
              "value": "-"
            },
            {
              "id": "info_cool_mode",
              "type": "label",
              "label": {
                "en": "Cool mode code",
                "fr": "Code mode froid"
              },
              "hint": {
                "en": "Raw coolMode value reported by the heat pump. Panasonic does not document its meaning, so it is shown unmodified rather than guessed at.",
                "fr": "Valeur brute coolMode remontee par la pompe a chaleur. Sa signification n'est pas documentee par Panasonic : elle est affichee telle quelle plutot que devinee."
              },
              "value": "-"
            },
            {
              "id": "info_tank",
              "type": "label",
              "label": {
                "en": "Domestic hot water tank",
                "fr": "Ballon d'eau chaude sanitaire"
              },
              "value": "-"
            },
            {
              "id": "info_bivalent",
              "type": "label",
              "label": {
                "en": "Bivalent source",
                "fr": "Source bivalente"
              },
              "value": "-"
            },
            {
              "id": "info_external_heater",
              "type": "label",
              "label": {
                "en": "External heater",
                "fr": "Appoint externe"
              },
              "value": "-"
            },
            {
              "id": "info_control_box",
              "type": "label",
              "label": {
                "en": "Control box",
                "fr": "Boitier de commande"
              },
              "value": "-"
            },
            {
              "id": "info_eco_comfort",
              "type": "label",
              "label": {
                "en": "Eco / Comfort offsets",
                "fr": "Decalages Eco / Confort"
              },
              "hint": {
                "en": "Zone offsets configured on the heat pump for the Eco and Comfort presets (heat / cool).",
                "fr": "Decalages de zone configures sur la pompe a chaleur pour les prereglages Eco et Confort (chaud / froid)."
              },
              "value": "-"
            },
            {
              "id": "info_last_update",
              "type": "label",
              "label": {
                "en": "Last cloud update",
                "fr": "Dernier rafraichissement cloud"
              },
              "value": "-"
            }
